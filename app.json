{
  "expo": {
    "name": "SplitSmart",
    "slug": "splitsmart",
    "scheme": "splitsmart",
    "version": "1.10.5",
    "orientation": "portrait",
    "icon": "./assets/splitsmart/splash-icon-app_google.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splitsmart/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#4B89DC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cbalucas.splitsmart"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splitsmart/splash-icon-app_google.png",
        "backgroundColor": "#4B89DC"
      },
      "package": "com.cbalucas.splitsmart",
      "versionCode": 30,
      "permissions": [
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Esta aplicación necesita acceso a tus fotos para agregar comprobantes a los gastos.",
          "cameraPermission": "Esta aplicación necesita acceso a la cámara para tomar fotos de comprobantes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SplitSmart necesita acceso a la cámara para escanear códigos QR de invitación."
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/splitsmart/splash-icon-app_google.png",
      "name": "SplitSmart",
      "shortName": "SplitSmart",
      "description": "Divide gastos entre amigos de forma inteligente",
      "themeColor": "#4B89DC",
      "backgroundColor": "#4B89DC",
      "lang": "es"
    },
    "updates": {
      "enabled": false
    },
    "owner": "cbalucas1983",
    "extra": {
      "eas": {
        "projectId": "dc732165-2502-4095-8bbd-5e5221823b7a"
      }
    }
  }
}
